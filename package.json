{
	"name": "better-auth-siwf",
	"version": "1.0.23",
	"description": "better-auth plugin for Sign In With Farcaster",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js",
			"require": "./dist/client.cjs"
		}
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "tsc && chmod +x ./dist/index.js"
	},
	"keywords": [
		"better-auth",
		"farcaster",
		"siwf",
		"plugin"
	],
	"author": "buildersgarden",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/builders-garden/better-auth-siwf.git"
	},
	"bugs": {
		"url": "https://github.com/builders-garden/better-auth-siwf/issues"
	},
	"homepage": "https://github.com/builders-garden/better-auth-siwf#readme",
	"peerDependencies": {
		"better-auth": "^1.0.0"
	},
	"dependencies": {
		"@farcaster/quick-auth": "^0.0.8",
		"better-auth": "^1.4.5",
		"viem": "^2.43.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/node": "^24.7.2",
		"typescript": "^5"
	}
}
